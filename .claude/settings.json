{
  "permissions": {
    "allow": [
      "Edit(~/.claude/skills/video-clip-select/**)",
      "Edit(~/.claude/skills/video-script-breakdown/**)",
      "Edit(~/.claude/skills/video-production/**)",
      "WebFetch(domain:www.qbitai.com)",
      "WebFetch(domain:www.stcn.com)",
      "WebFetch(domain:36kr.com)",
      "WebFetch(domain:www.xiaohongshu.com)",
      "WebFetch(domain:www.thepaper.cn)",
      "WebFetch(domain:news.qq.com)",
      "WebFetch(domain:research.szltech.com)",
      "WebFetch(domain:www.sdyanbao.com)",
      "WebFetch(domain:www.zhihu.com)",
      "WebFetch(domain:www.gamersky.com)",
      "WebFetch(domain:www.fxbaogao.com)",
      "WebFetch(domain:www.36kr.com)",
      "WebFetch(domain:www.vzkoo.com)",
      "WebFetch(domain:www.shobserver.com)",
      "WebFetch(domain:www.opp2.com)",
      "WebFetch(domain:www.douban.com)",
      "WebFetch(domain:www.newrank.cn)",
      "Edit(~/.claude/skills/video-review/**)"
    ],
    "additionalDirectories": [
      "c:\\Users\\hangn\\.claude\\skills\\video-clip-select",
      "C:\\Users\\hangn\\.claude"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/projects/mason-hub/scripts/hooks/session-bootstrap.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/projects/mason-hub/scripts/hooks/guardrail.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/projects/mason-hub/scripts/hooks/format-validator.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/projects/mason-hub/scripts/hooks/research-pipeline-guard.sh",
            "timeout": 5,
            "statusMessage": "检查调研管线..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd ~/projects/mason-hub && python3 scripts/update-system-state.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/projects/mason-hub/scripts/hooks/pre-compact.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
