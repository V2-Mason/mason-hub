      "start": 594.04,
      "end": 595.92,
      "text": "而那时候的新能源汽车呢"
    },
    {
      "start": 595.92,
      "end": 596.28,
      "text": "不行"
    },
    {
      "start": 596.28,
      "end": 597.86,
      "text": "要等到2016年后"
    },
    {
      "start": 597.86,
      "end": 599.7,
      "text": "才会有一些比较不错的机会"
    },
    {
      "start": 599.7,
      "end": 601.94,
      "text": "当时的宁德时代还没有成为宁王"
    },
    {
      "start": 601.94,
      "end": 604.38,
      "text": "理想小鹏未来刚成立没几年"
    },
    {
      "start": 604.38,
      "end": 606.56,
      "text": "才处在PPT造车的阶段"
    },
    {
      "start": 606.56,
      "end": 607.74,
      "text": "真正开始批量"
    },
    {
      "start": 607.74,
      "end": 609.78,
      "text": "招人是在2018年前后"
    },
    {
      "start": 609.78,
      "end": 612.32,
      "text": "那时候新势力开始交付第一辆车"
    },
    {
      "start": 612.32,
      "end": 614.08,
      "text": "传统特企也开始转型"
    },
    {
      "start": 614.08,
      "end": 616.12,
      "text": "懂电信配方或者BMS"
    },
    {
      "start": 616.12,
      "end": 617.96,
      "text": "电池管理系统的工程师"
    },
    {
      "start": 617.96,
      "end": 619.88,
      "text": "跳槽薪资翻倍非常正常"
    },
    {
      "start": 619.88,
      "end": 620.74,
      "text": "我想说的是"
    },
    {
      "start": 620.74,
      "end": 622.02,
      "text": "结合今年15规划"
    },
    {
      "start": 622.02,
      "end": 624.34,
      "text": "新能源汽车的红离7其实还没有结束"
    },
    {
      "start": 624.34,
      "end": 626.84,
      "text": "因为进入了下半场的智能支架时代"
    },
    {
      "start": 626.84,
      "end": 628.58,
      "text": "仓架融合开发工程师智能"
    },
    {
      "start": 628.58,
      "end": 630.28,
      "text": "坐仓产生总监可以达到"
    },
    {
      "start": 630.28,
      "end": 632.08,
      "text": "50到上百万元的年薪"
    },
    {
      "start": 632.08,
      "end": 632.8,
      "text": "所以你看"
    },
    {
      "start": 632.8,
      "end": 634.2,
      "text": "同样一个产业方向"
    },
    {
      "start": 634.2,
      "end": 635.38,
      "text": "进场的时间点不一样"
    },
    {
      "start": 635.38,
      "end": 636.7,
      "text": "车道的红离也完全不一样"
    },
    {
      "start": 636.7,
      "end": 638.58,
      "text": "对于刚要择业的年轻人来说"
    },
    {
      "start": 638.58,
      "end": 640.26,
      "text": "最好选择五年规划里"
    },
    {
      "start": 640.26,
      "end": 642.78,
      "text": "前面已经奋斗过一个五年规划的"
    },
    {
      "start": 642.78,
      "end": 643.84,
      "text": "成长期产业"
    },
    {
      "start": 643.84,
      "end": 646.16,
      "text": "那对于一些还停留在实验室的新兴技术"
    },
    {
      "start": 646.16,
      "end": 649.06,
      "text": "更适合还在义务教育阶段上学的学生"
    },
    {
      "start": 649.06,
      "end": 650.46,
      "text": "作为未来的职业参考"
    },
    {
      "start": 650.46,
      "end": 653.32,
      "text": "另外还有一个被很多人都忽略的点"
    },
    {
      "start": 653.32,
      "end": 656.12,
      "text": "互联网下半场以及AI战略确立后"
    },
    {
      "start": 656.12,
      "end": 657.4,
      "text": "复合型人才的缺口"
    },
    {
      "start": 657.4,
      "end": 659.02,
      "text": "其实要比想象中的要大很多"
    },
    {
      "start": 659.02,
      "end": 661.14,
      "text": "除了前面说的AI加汽车"
    },
    {
      "start": 661.14,
      "end": 662.86,
      "text": "还有AI加创新教"
    },
    {
      "start": 662.86,
      "end": 665.58,
      "text": "也在同样经历着百万年薪抢容的阶段"
    },
    {
      "start": 665.58,
      "end": 667.62,
      "text": "那具体到十五规划里面"
    },
    {
      "start": 667.62,
      "end": 668.88,
      "text": "像集权电路"
    },
    {
      "start": 668.88,
      "end": 669.82,
      "text": "生物医药"
    },
    {
      "start": 669.82,
      "end": 670.62,
      "text": "航空航天"
    },
    {
      "start": 670.62,
      "end": 671.6,
      "text": "低空经济"
    },
    {
      "start": 671.6,
      "end": 672.48,
      "text": "新型储能"
    },
    {
      "start": 672.48,
      "end": 673.12,
      "text": "聚生智能"
    },
    {
      "start": 673.12,
      "end": 675.28,
      "text": "这些已经在规划里至少跑过"
    },
    {
      "start": 675.28,
      "end": 676.56,
      "text": "一个五年的行业"
    },
    {
      "start": 676.56,
      "end": 677.48,
      "text": "三到五年里"
    },
    {
      "start": 677.48,
      "end": 678.34,
      "text": "需求紧喷"
    },
    {
      "start": 678.34,
      "end": 680.84,
      "text": "适合大多数准备择业的人"
    },
    {
      "start": 680.84,
      "end": 681.7,
      "text": "但是量子科技"
    },
    {
      "start": 681.7,
      "end": 683.28,
      "text": "气能和核聚变能"
    },
    {
      "start": 683.28,
      "end": 684.04,
      "text": "脑机接口"
    },
    {
      "start": 684.04,
      "end": 684.72,
      "text": "聚生智能"
    },
    {
      "start": 684.72,
      "end": 687.4,
      "text": "6G这些还在实验室阶段的未来产业"
    },
    {
      "start": 687.4,
      "end": 689.52,
      "text": "预计还需要至少一个五年以上"
    },
    {
      "start": 689.52,
      "end": 690.72,
      "text": "才能看清的机会呢"
    },
    {
      "start": 690.72,
      "end": 692.04,
      "text": "到2023年后呢"
    },
    {
      "start": 692.04,
      "end": 693.68,
      "text": "才可能处于大爆发的前夜"
    },
    {
      "start": 693.68,
      "end": 695.6,
      "text": "就适合还在念书的学生"
    },
    {
      "start": 695.6,
      "end": 697.58,
      "text": "或者想要冲击前夜研发港的人"
    },
    {
      "start": 697.58,
      "end": 698.74,
      "text": "关注伦巴蒂宝姐"
    },
    {
      "start": 698.74,
      "end": 700.96,
      "text": "带你读动新资产背后的财富逻辑"
    },
    {
      "start": 700.96,
      "end": 702.46,
      "text": "我们下期再见"
    },
    {
      "start": 702.46,
      "end": 703.46,
      "text": "我们下期再见"
    },
    {
      "start": 703.46,
      "end": 704.46,
      "text": "再见"
    }
  ]
}