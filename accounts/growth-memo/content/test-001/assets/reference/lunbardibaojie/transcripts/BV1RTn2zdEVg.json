    {
      "start": 774.5,
      "end": 777.16,
      "text": "文定币迎来新一轮的洗牌"
    },
    {
      "start": 777.16,
      "end": 778.88,
      "text": "2022年5月"
    },
    {
      "start": 778.88,
      "end": 781.52,
      "text": "币圈迎来雷曼时刻"
    },
    {
      "start": 781.52,
      "end": 784.4,
      "text": "算法稳定币UST严重脱钩"
    },
    {
      "start": 784.4,
      "end": 786.2,
      "text": "触发死亡螺旋"
    },
    {
      "start": 786.2,
      "end": 788.78,
      "text": "这是稳定币第一次出圈"
    },
    {
      "start": 788.78,
      "end": 792.02,
      "text": "韩国本土的投资者损失最惨重"
    },
    {
      "start": 792.02,
      "end": 794.04,
      "text": "许多家庭倾家荡产"
    },
    {
      "start": 794.04,
      "end": 796.14,
      "text": "甚至走上自杀这条绝路"
    },
    {
      "start": 796.14,
      "end": 798.24,
      "text": "Tarrow的创办者Duno"
    },
    {
      "start": 798.24,
      "end": 800.36,
      "text": "最近在美国认罪服刑"
    },
    {
      "start": 800.36,
