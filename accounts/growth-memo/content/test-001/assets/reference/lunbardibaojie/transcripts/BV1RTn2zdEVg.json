      "text": "VISA、MASCARD都开始试点"
    },
    {
      "start": 745.3,
      "end": 747.16,
      "text": "小范围支持USDC支付"
    },
    {
      "start": 747.16,
      "end": 749.16,
      "text": "但不那么完美的USDT"
    },
    {
      "start": 749.16,
      "end": 752.52,
      "text": "已经从家里场景渗透到全球跨境汇款"
    },
    {
      "start": 752.52,
      "end": 754.72,
      "text": "商户支付甚至非法交易"
    },
    {
      "start": 754.72,
      "end": 757.18,
      "text": "稳稳地做出了龙头地位"
    },
    {
      "start": 757.18,
      "end": 758.66,
      "text": "2020年8月"
    },
    {
      "start": 758.66,
      "end": 762.0,
      "text": "文定币市值首次突破千亿美元大关"
    },
    {
      "start": 762.0,
      "end": 765.38,
      "text": "文定币格局已经从USDT一家独武"
    },
    {
      "start": 765.38,
      "end": 767.08,
      "text": "进入了USDT主导"
    },
    {
      "start": 767.08,
      "end": 770.32,
      "text": "USDC、BUSD、DAI、USDT等"
    },
    {
      "start": 770.32,
      "end": 772.16,
      "text": "多足鼎立的局面"
    },
    {
      "start": 772.16,
      "end": 774.5,
      "text": "随着DeFi Summer进入尾声"
