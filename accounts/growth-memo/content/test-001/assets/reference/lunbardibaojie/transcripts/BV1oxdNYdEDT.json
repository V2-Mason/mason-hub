    {
      "start": 345.43,
      "end": 346.99,
      "text": "旗下的这个美元文秘密业务"
    },
    {
      "start": 346.99,
      "end": 348.31,
      "text": "也就是后来的Tether"
    },
    {
      "start": 348.31,
      "end": 349.63,
      "text": "除了德巴西尼外"
    },
    {
      "start": 349.63,
      "end": 351.29,
      "text": "Tether还有三位重要的股东"
    },
    {
      "start": 351.29,
      "end": 352.91,
      "text": "分别是Tether的首任CEO"
    },
    {
      "start": 352.91,
      "end": 354.29,
      "text": "Tether的总法律顾问"
    },
    {
      "start": 354.29,
      "end": 355.79,
      "text": "还有Tether的早期投资者"
    },
    {
      "start": 355.79,
      "end": 357.03,
      "text": "分别掌握着Tether"
    },
    {
      "start": 357.03,
      "end": 358.35,
      "text": "15%左右的股份"
    },
    {
      "start": 358.35,
      "end": 359.63,
      "text": "那么联合德巴西尼呢"
    },
    {
      "start": 359.63,
      "end": 360.67,
      "text": "总共守过Tether"
    },
    {
      "start": 360.67,
      "end": 362.49,
      "text": "大概86%的股份"
    },
    {
      "start": 362.49,
      "end": 363.71,
      "text": "除了这四大股东啊"
    },
    {
      "start": 363.71,
      "end": 364.61,
      "text": "Tether创立海里"
    },
    {
      "start": 364.61,
      "end": 365.93,
      "text": "还一个关键证物"
    },
    {
      "start": 365.93,
      "end": 367.99,
      "text": "美国同心"
    },
    {
      "start": 367.99,
      "end": 368.81,
      "text": "Flock Pears"
    },
    {
      "start": 368.81,
      "end": 370.21,
      "text": "他是Tether的前身"
    },
    {
      "start": 370.21,
      "end": 371.51,
      "text": "Real Khan的创办者"
    },
    {
      "start": 371.51,
      "end": 372.71,
      "text": "也可以说是Tether"
    },
    {
      "start": 372.71,
      "end": 373.95,
      "text": "重要的连创之一"
    },
    {
      "start": 373.95,
      "end": 375.55,
      "text": "也正是他推动了"
    },
    {
      "start": 375.55,
      "end": 376.83,
      "text": "美元里面的概念"
    },
    {
      "start": 376.83,
      "end": 378.91,
      "text": "你说这个美国的这个同心"
    },
    {
      "start": 378.91,
      "end": 380.71,
      "text": "怎么就这么多财多益呢"
    },
    {
      "start": 380.71,
      "end": 381.41,
      "text": "那Pears呢"
    },
    {
      "start": 381.41,
      "end": 382.83,
      "text": "之前是Noble银行的实控人"
    },
    {
      "start": 382.83,
      "end": 384.15,
      "text": "这家银行曾经是Tether"
    },
    {
      "start": 384.15,
      "end": 384.83,
      "text": "比特菲尼克的"
    },
    {
      "start": 384.83,
      "end": 386.37,
      "text": "主要资金图管机构"
    },
    {
      "start": 386.37,
      "end": 387.91,
      "text": "Real Khan在2014年底"
    },
    {
      "start": 387.91,
      "end": 388.73,
      "text": "更名为Tether"
    },
    {
      "start": 388.73,
      "end": 390.09,
      "text": "所有权业都转让给了"
    },
    {
      "start": 390.09,
      "end": 391.13,
      "text": "比特菲尼克的母公司"
    },
    {
      "start": 391.13,
      "end": 391.83,
      "text": "iPhenix"
    },
    {
      "start": 391.83,
      "end": 393.69,
      "text": "那Tether能够一直屹立不倒"
    },
    {
      "start": 393.69,
      "end": 394.95,
      "text": "也离开他强大的"
    },
    {
      "start": 394.95,
      "end": 396.01,
      "text": "政府网络关系"
    },
    {
      "start": 396.01,
      "end": 396.63,
      "text": "比如说"
    },
    {
      "start": 396.63,
      "end": 397.69,
      "text": "川普上台以后"
    },
    {
      "start": 397.69,
      "end": 399.17,
      "text": "在新商务部长鲁特尼克"
    },
    {
      "start": 399.17,
      "end": 400.61,
      "text": "还有川普政府早期的"
    },
    {
      "start": 400.61,
      "end": 401.09,
      "text": "核心目标"
    },
    {
      "start": 401.09,
      "end": 401.77,
      "text": "Steve Bannon"
    },
    {
      "start": 401.77,
      "end": 402.45,
      "text": "这两位啊"
    },
    {
      "start": 402.45,
      "end": 403.61,
      "text": "新商务部长鲁特尼克"
    },
    {
      "start": 403.61,
      "end": 405.09,
      "text": "他创办的金融公司"
    },
    {
      "start": 405.09,
      "end": 405.99,
      "text": "Kentafiz Gerard"
    },
    {
      "start": 405.99,
      "end": 406.95,
      "text": "是Tether股东"
    },
    {
      "start": 406.95,
      "end": 408.27,
      "text": "有Tether5%的股权"
    },
    {
      "start": 408.27,
      "end": 409.75,
      "text": "这家公司还曾管理着"
    },
    {
      "start": 409.75,
      "end": 411.57,
      "text": "Tether超一半的储备资产"
    },
    {
      "start": 411.57,
      "end": 412.79,
      "text": "靠着给Tether脱管"
    },
    {
      "start": 412.79,
      "end": 413.79,
      "text": "Kentafiz Gerard"
    },
    {
      "start": 413.79,
      "end": 415.21,
      "text": "赚了大几七万美元"
    },
    {
      "start": 415.21,
      "end": 416.53,
      "text": "那还有川普政府"
    },
    {
      "start": 416.53,
      "end": 417.53,
      "text": "早期的核心目标"
    },
    {
      "start": 417.53,
      "end": 418.23,
      "text": "Steve Bannon"
    },
    {
      "start": 418.23,
      "end": 420.07,
      "text": "和Tether联合创始人"
    },
    {
      "start": 420.07,
      "end": 420.85,
      "text": "Block Pears"
    },
    {
      "start": 420.85,
      "end": 421.67,
      "text": "关系密切"
    },
    {
      "start": 421.67,
      "end": 423.79,
      "text": "Block Pears在创立Tether之前"
    },
    {
      "start": 423.79,
      "end": 425.27,
      "text": "曾聘请Steve Bannon"
    },
    {
      "start": 425.27,
      "end": 426.31,
      "text": "帮他的游戏公司"
    },
    {
      "start": 426.31,
      "end": 427.89,
      "text": "埃及已经收购过融资"
    },
    {
      "start": 427.89,
      "end": 429.05,
      "text": "他们两个错在一起"
    },
    {
      "start": 429.05,
      "end": 430.81,
      "text": "才参与了不少去观点项目"
    },
    {
      "start": 430.81,
      "end": 431.53,
      "text": "但也正是因为"
    },
    {
      "start": 431.53,
      "end": 432.77,
      "text": "这复杂的政商关系"
    },
    {
      "start": 432.77,
      "end": 434.31,
      "text": "加上Tether本来就不透明"
    },
    {
      "start": 434.31,
      "end": 436.13,
      "text": "缺监管的资金运作模式"
    },
    {
      "start": 436.13,
      "end": 437.53,
      "text": "让Tether的自成立"
    },
    {
      "start": 437.53,
      "end": 439.29,
      "text": "在Web3群中饱受争议"
    },
    {
      "start": 439.29,
      "end": 440.41,
      "text": "Tether成长之路"
    },
    {
      "start": 440.41,
      "end": 441.37,
      "text": "也并不是一番风顺"
    },
    {
      "start": 441.37,
      "end": 443.21,
      "text": "因为资金流向和储备的问题"
    },
    {
      "start": 443.21,
      "end": 444.63,
      "text": "多次遭遇信任危机"
    },
    {
      "start": 444.63,
      "end": 446.21,
      "text": "Tether也是美国政府"
    },
    {
      "start": 446.21,
      "end": 447.83,
      "text": "一直眼里的这个眼农精"
    },
    {
      "start": 447.83,
      "end": 449.71,
      "text": "美国政府多次调查"
    },
    {
      "start": 449.71,
      "end": 450.77,
      "text": "并指控Tether"
    },
    {
      "start": 450.77,
      "end": 451.59,
      "text": "逃动资装"
    },
    {
      "start": 453.79,
      "end": 454.33,
      "text": "历史到现在"
    },
    {
      "start": 454.33,
      "end": 455.25,
      "text": "Tether会被爆雷"
    },
    {
      "start": 455.25,
      "end": 456.07,
      "text": "什么时候会爆雷"
    },
    {
      "start": 456.07,
      "end": 457.17,
      "text": "依然是悬在"
    },
    {
      "start": 457.17,
      "end": 458.81,
      "text": "每个Web3用户头顶的"
    },
    {
      "start": 458.81,
      "end": 459.77,
      "text": "达摩克里斯线"
    },
    {
      "start": 459.77,
      "end": 461.05,
      "text": "但无论如何"
    },
    {
      "start": 461.05,
      "end": 462.29,
      "text": "Tether的发家之路"
    },
    {
      "start": 462.29,
      "end": 463.17,
      "text": "放眼古今"
    },
    {
      "start": 463.17,
      "end": 464.95,
      "text": "绝对是一个传奇般的存在"
    },
    {
      "start": 464.95,
      "end": 465.89,
      "text": "有意思的是"
    },
    {
      "start": 465.89,
      "end": 466.79,
      "text": "它的崛起"
    },
    {
      "start": 466.79,
      "end": 468.85,
      "text": "离不开中国市场的大力推动"
    },
    {
      "start": 468.85,
      "end": 469.81,
      "text": "如果你感兴趣"
    },
    {
      "start": 469.81,
      "end": 471.17,
      "text": "下一期我们重点聊一聊"
    },
    {
      "start": 471.17,
      "end": 473.21,
      "text": "Tether的发家时和危难时刻"
    },
    {
      "start": 473.21,
      "end": 474.39,
      "text": "关注人马蒂宝姐"
    },
    {
      "start": 474.39,
      "end": 476.39,
      "text": "让世界上没有难懂的Web3生意"
    }
  ]
}