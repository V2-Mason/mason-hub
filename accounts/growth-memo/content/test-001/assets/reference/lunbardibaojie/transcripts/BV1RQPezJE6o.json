    },
    {
      "start": 634.34,
      "end": 636.16,
      "text": "这场游戏到了转折点意味着什么"
    },
    {
      "start": 636.16,
      "end": 637.3,
      "text": "对于个人而言"
    },
    {
      "start": 637.3,
      "end": 639.34,
      "text": "你的所有用美元计价的资产"
    },
    {
      "start": 639.34,
      "end": 640.82,
      "text": "都需要进行重新的评估"
    },
    {
      "start": 640.82,
      "end": 642.26,
      "text": "黄金突破5000美元"
    },
    {
      "start": 642.26,
      "end": 644.06,
      "text": "是全球信用重购的开始"
    },
    {
      "start": 644.06,
      "end": 644.88,
      "text": "这重申一点"
    },
    {
      "start": 644.88,
      "end": 646.72,
      "text": "黄金不是投机的工具"
    },
    {
      "start": 646.72,
      "end": 648.14,
      "text": "那从国家层面的叙事"
    },
    {
      "start": 648.14,
      "end": 648.84,
      "text": "也许我们听到"
    },
    {
      "start": 648.84,
      "end": 651.14,
      "text": "人民币国际化取代美元会很兴奋"
    },
    {
      "start": 651.14,
      "end": 652.94,
      "text": "可是美元已经告诉我们"
    },
    {
      "start": 652.94,
      "end": 655.12,
      "text": "全球储位货币是一把双刃剑"
    },
    {
      "start": 655.12,
      "end": 657.08,
      "text": "机能收割全球也会被反噬"
    },
    {
      "start": 657.08,
      "end": 659.16,
      "text": "那对现在所有的人而言"
    },
    {
      "start": 659.16,
      "end": 661.34,
      "text": "这还是一次见证历史的机会"
    },
    {
      "start": 661.34,
      "end": 663.4,
      "text": "从1944年布雷顿森林体系"
    },
    {
      "start": 663.4,
      "end": 665.08,
      "text": "到1971年尼克松冲击"
    },
    {
      "start": 665.08,
      "end": 667.04,
      "text": "到2025年关税转折"
    },
    {
      "start": 667.04,
      "end": 668.56,
      "text": "世界货币体系重塑"
    },
    {
      "start": 668.56,
      "end": 669.52,
      "text": "而这一次"
    },
    {
      "start": 669.52,
      "end": 670.78,
      "text": "你不再是旁观者"
    },
    {
      "start": 670.78,
      "end": 671.7,
      "text": "你是亲历者"
    },
    {
      "start": 671.7,
      "end": 672.86,
      "text": "你的每一个选择"
    },
    {
      "start": 672.86,
      "end": 674.84,
      "text": "都决定你的财富站在哪边"
    },
    {
      "start": 674.84,
      "end": 676.22,
      "text": "关注了马蒂宝姐"
    },
    {
      "start": 676.22,
      "end": 678.24,
      "text": "带你读动新资产背后的财富逻辑"
    }
  ]
}