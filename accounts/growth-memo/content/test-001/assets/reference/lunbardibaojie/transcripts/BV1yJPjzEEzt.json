    {
      "start": 295.56,
      "end": 296.56,
      "text": "一年周转6趟"
    },
    {
      "start": 296.56,
      "end": 298.0,
      "text": "乘上25%的毛利"
    },
    {
      "start": 298.0,
      "end": 299.68,
      "text": "是1.5倍的资金回报率"
    },
    {
      "start": 300.66,
      "end": 301.32,
      "text": "没关系"
    },
    {
      "start": 301.32,
      "end": 302.32,
      "text": "只要周转够快"
    },
    {
      "start": 302.32,
      "end": 303.72,
      "text": "总回报率反而会更高"
    },
    {
      "start": 303.72,
      "end": 305.34,
      "text": "那为什么周转可以这么快"
    },
    {
      "start": 305.34,
      "end": 306.62,
      "text": "因为这类临时折扣店"
