    {
      "start": 197.86,
      "end": 199.38,
      "text": "他们售卖的大品牌零食"
    },
    {
      "start": 199.38,
      "end": 200.48,
      "text": "其实根本不赚钱"
    },
    {
      "start": 200.48,
      "end": 201.24,
      "text": "像可有可乐"
    },
    {
      "start": 201.24,
      "end": 202.4,
      "text": "娃哈哈这些大品牌"
