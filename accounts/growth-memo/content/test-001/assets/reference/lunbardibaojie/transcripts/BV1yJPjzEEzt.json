    {
      "start": 217.76,
      "end": 218.6,
      "text": "建了大牌食品"
    },
    {
      "start": 218.6,
      "end": 219.74,
      "text": "还有一类进不去"
    },
    {
      "start": 219.74,
      "end": 221.6,
      "text": "传统大商商的小众品牌"
    },
    {
      "start": 221.6,
      "end": 222.48,
      "text": "这部分小众品牌"
    },
    {
      "start": 222.48,
      "end": 223.28,
      "text": "占比超过一半"
    },
    {
      "start": 223.28,
      "end": 224.7,
      "text": "所以这里的诀窍就是"
    },
    {
      "start": 224.7,
      "end": 226.5,
      "text": "大牌引流加上小众品牌"
