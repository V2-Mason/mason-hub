    {
      "start": 166.2,
      "end": 166.84,
      "text": "再到商超"
    },
    {
      "start": 166.84,
      "end": 167.98,
      "text": "最后再到消费者"
    },
    {
      "start": 167.98,
      "end": 169.54,
      "text": "每一层加价20%"
    },
    {
      "start": 169.54,
      "end": 171.0,
      "text": "整体加价率80%"
    },
    {
      "start": 171.0,
      "end": 172.46,
      "text": "最后4块多一包的薯片"
    },
    {
      "start": 172.46,
      "end": 173.8,
      "text": "到你手里是9块"
    },
    {
      "start": 173.8,
      "end": 175.0,
      "text": "但明明很忙就只有"
    },
    {
      "start": 175.0,
      "end": 176.34,
      "text": "工厂到应证扣品牌"
    },
    {
      "start": 176.34,
      "end": 177.44,
      "text": "再到加盟门店"
    },
    {
      "start": 177.44,
      "end": 178.78,
      "text": "砍掉所有中间商"
