    },
    {
      "start": 537.18,
      "end": 539.06,
      "text": "按当时1.6万家门店推算"
    },
    {
      "start": 539.06,
      "end": 540.46,
      "text": "单店平均月收入"
    },
    {
      "start": 540.46,
      "end": 542.2,
      "text": "大概在40.79万元"
    },
    {
      "start": 542.2,
      "end": 542.86,
      "text": "注意啊"
    },
    {
      "start": 542.86,
      "end": 544.26,
      "text": "这是门店的零售总额"
    },
    {
      "start": 544.26,
      "end": 545.64,
      "text": "不是实际到手的营收"
    },
    {
      "start": 545.64,
      "end": 547.36,
      "text": "行业里零售折扣店的"
    },
    {
      "start": 547.36,
      "end": 548.56,
      "text": "终端销售毛利率"
    },
    {
      "start": 548.56,
      "end": 549.84,
      "text": "普遍在18个点左右"
    },
    {
      "start": 549.84,
      "end": 551.52,
      "text": "我们按这个理想数值算"
    },
    {
      "start": 551.52,
      "end": 552.6,
      "text": "单店月均毛利"
    },
    {
      "start": 552.6,
      "end": 553.76,
      "text": "大概在7.3万元"
    },
    {
      "start": 553.76,
      "end": 554.9,
      "text": "再扣除每月房租"
    },
    {
      "start": 554.9,
      "end": 555.52,
      "text": "人工水电"
    },
    {
      "start": 555.52,
      "end": 557.14,
      "text": "损耗等固定运营成本"
    },
    {
      "start": 557.14,
      "end": 558.54,
      "text": "普遍在5万元左右"
    },
    {
      "start": 558.54,
      "end": 559.8,
      "text": "那么在理想状态下"
    },
    {
      "start": 559.8,
      "end": 561.22,
      "text": "单店月度经营利润"
    },
    {
      "start": 561.22,
      "end": 562.26,
      "text": "大概在2.3万元"
    },
    {
      "start": 562.26,
      "end": 563.5,
      "text": "那么回本周期就是"
    },
    {
      "start": 563.5,
      "end": 564.38,
      "text": "26个月"
    },
    {
      "start": 564.38,
      "end": 565.0,
      "text": "两年多"
    },
    {
      "start": 565.0,
      "end": 565.84,
      "text": "也就是说"
    },
    {
      "start": 565.84,
      "end": 566.78,
      "text": "在一切顺利"
    },
    {
      "start": 566.78,
      "end": 567.62,
      "text": "月月都能保持"
    },
    {
      "start": 567.62,
      "end": 569.12,
      "text": "40万流水的理想情况下"
    },
    {
      "start": 569.12,
      "end": 570.08,
      "text": "也需要两年多"
    },
    {
      "start": 570.08,
      "end": 570.9,
      "text": "才能收回本金"
    },
    {
      "start": 570.9,
      "end": 571.66,
      "text": "但现实是"
    },
    {
      "start": 571.66,
      "end": 572.72,
      "text": "随着门店加密"
    },
    {
      "start": 572.72,
      "end": 573.34,
      "text": "竞争家具"
    },
    {
      "start": 573.34,
      "end": 574.1,
      "text": "新开门店"
    },
    {
      "start": 574.1,
      "end": 575.58,
      "text": "不是在开拓新市场"
    },
    {
      "start": 575.58,
      "end": 577.32,
      "text": "而是在分流老店的客流"
    },
    {
      "start": 577.32,
      "end": 578.22,
      "text": "未来能不能持续"
    },
    {
      "start": 578.22,
      "end": 578.68,
      "text": "这个流水"
    },
    {
      "start": 578.68,
      "end": 579.36,
      "text": "真的很难说"
    },
    {
      "start": 579.36,
      "end": 580.36,
      "text": "对于经验不足的"
    },
    {
      "start": 580.36,
      "end": 581.4,
      "text": "新加盟商来说"
    },
    {
      "start": 581.4,
      "end": 583.08,
      "text": "现在入局亏本的风险"
    },
    {
      "start": 583.08,
      "end": 583.72,
      "text": "并不算低"
    },
    {
      "start": 583.72,
      "end": 585.08,
      "text": "那对于明明很忙来说"
    },
    {
      "start": 585.08,
      "end": 586.34,
      "text": "未来还有品控压力"
    },
    {
      "start": 586.34,
      "end": 587.16,
      "text": "和转型的风险"
    },
    {
      "start": 587.16,
      "end": 587.74,
      "text": "前面提到"
    },
    {
      "start": 587.74,
      "end": 588.74,
      "text": "临时店里很多都是"
    },
    {
      "start": 588.74,
      "end": 589.64,
      "text": "白牌产品"
    },
    {
      "start": 589.64,
      "end": 591.2,
      "text": "依赖于中小代工厂"
    },
    {
      "start": 591.2,
      "end": 592.1,
      "text": "管理难度极大"
    },
    {
      "start": 592.1,
      "end": 592.84,
      "text": "一旦出现"
    },
    {
      "start": 592.84,
      "end": 594.04,
      "text": "重大食品安全事件"
    },
    {
      "start": 594.04,
      "end": 595.02,
      "text": "品牌和加盟商"
    },
    {
      "start": 595.02,
      "end": 596.02,
      "text": "都难逃追责"
    },
    {
      "start": 596.02,
      "end": 597.12,
      "text": "现在明明很忙"
    },
    {
      "start": 597.12,
      "end": 597.98,
      "text": "正在转型上"
    },
    {
      "start": 597.98,
      "end": 599.08,
      "text": "推出省钱超市"
    },
    {
      "start": 599.08,
      "end": 599.96,
      "text": "做自由品牌"
    },
    {
      "start": 599.96,
      "end": 600.96,
      "text": "试图提升毛利"
    },
    {
      "start": 600.96,
      "end": 602.08,
      "text": "但能否跑通"
    },
    {
      "start": 602.08,
      "end": 603.18,
      "text": "需要时间验证"
    },
    {
      "start": 603.18,
      "end": 604.74,
      "text": "这条路奥勒奇走通了"
    },
    {
      "start": 604.74,
      "end": 606.4,
      "text": "但奥勒奇用了几十年"
    },
    {
      "start": 606.4,
      "end": 607.82,
      "text": "难度可想而知"
    },
    {
      "start": 607.82,
      "end": 608.76,
      "text": "最后我们回到"
    },
    {
      "start": 608.76,
      "end": 609.62,
      "text": "最开始的问题"
    },
    {
      "start": 609.62,
      "end": 610.82,
      "text": "靠卖低价零食"
    },
    {
      "start": 610.82,
      "end": 611.86,
      "text": "真的能撑起一个"
    },
    {
      "start": 611.86,
      "end": 613.32,
      "text": "千亿市值的帝国吗"
    },
    {
      "start": 613.32,
      "end": 613.64,
      "text": "能"
    },
    {
      "start": 613.64,
      "end": 614.9,
      "text": "但前提是"
    },
    {
      "start": 614.9,
      "end": 615.94,
      "text": "你要跑通"
    },
    {
      "start": 615.94,
      "end": 617.36,
      "text": "而不是靠跟风内卷"
    },
    {
      "start": 617.36,
      "end": 619.04,
      "text": "价格账和资本烧钱"
    },
    {
      "start": 619.04,
      "end": 620.66,
      "text": "上市只是一个开始"
    },
    {
      "start": 620.66,
      "end": 621.4,
      "text": "明明很忙"
    },
    {
      "start": 621.4,
      "end": 622.04,
      "text": "要么成为"
    },
    {
      "start": 622.04,
      "end": 623.38,
      "text": "中国版的奥勒奇"
    },
    {
      "start": 623.38,
      "end": 625.0,
      "text": "跑出万亿市值的"
    },
    {
      "start": 625.0,
      "end": 625.6,
      "text": "消费帝国"
    },
    {
      "start": 625.6,
      "end": 626.64,
      "text": "要么就又成为"
    },
    {
      "start": 626.64,
      "end": 627.82,
      "text": "一个昙花一现的"
    },
    {
      "start": 627.82,
      "end": 628.38,
      "text": "资本故事"
    },
    {
      "start": 628.38,
      "end": 629.74,
      "text": "关注轮巴迪宝姐"
    },
    {
      "start": 629.74,
      "end": 630.38,
      "text": "带你读动"
    },
    {
      "start": 630.38,
      "end": 631.32,
      "text": "薪资产背后的"
    },
    {
      "start": 631.32,
      "end": 632.32,
      "text": "财富逻辑"
    }
  ]
}