    {
      "start": 194.52,
      "end": 196.04,
      "text": "形成一个正向循环"
    },
    {
      "start": 196.04,
      "end": 196.84,
      "text": "但这里有一个"
    },
    {
      "start": 196.84,
      "end": 197.86,
      "text": "反常式的真相"
