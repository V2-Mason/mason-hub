    {
      "start": 266.34,
      "end": 267.48,
      "text": "剩下的才是利润"
    },
    {
      "start": 267.48,
      "end": 269.2,
      "text": "但如果你这批货周转慢"
    },
    {
      "start": 269.2,
      "end": 270.66,
      "text": "在仓库里压了60天"
    },
    {
      "start": 270.66,
      "end": 271.64,
      "text": "这10万元的毛利"
    },
    {
      "start": 271.64,
      "end": 273.0,
      "text": "可能还不够付这两个月的"
    },
    {
      "start": 273.0,
      "end": 274.46,
      "text": "仓库租金和资金利息"
