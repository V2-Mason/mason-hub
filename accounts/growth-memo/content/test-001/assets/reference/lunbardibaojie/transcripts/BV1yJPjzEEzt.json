    {
      "start": 288.26,
      "end": 289.86,
      "text": "同样100万元的资金"
    },
    {
      "start": 289.86,
      "end": 291.0,
      "text": "一年周转30趟"
    },
    {
      "start": 291.0,
      "end": 292.44,
      "text": "乘上10%的毛利"
    },
    {
      "start": 292.44,
      "end": 294.54,
      "text": "那就是3倍的年资金回报率"
