      "start": 307.56,
      "end": 309.12,
      "text": "零售外衣的数据公司"
    },
    {
      "start": 309.12,
      "end": 309.7,
      "text": "怎么理解"
    },
    {
      "start": 309.7,
      "end": 311.64,
      "text": "他们干的事叫做C2M"
    },
    {
      "start": 311.64,
      "end": 313.14,
      "text": "消费者直连制造商"
    },
    {
      "start": 313.14,
      "end": 314.3,
      "text": "说白了就是让消费者"
