    {
      "start": 242.32,
      "end": 243.02,
      "text": "自己种柠檬"
    },
    {
      "start": 243.02,
      "end": 243.86,
      "text": "自己身体"
    },
    {
      "start": 243.86,
      "end": 245.48,
      "text": "毛利能够到30%左右"
    },
    {
      "start": 245.48,
      "end": 247.74,
      "text": "明明狠王全部靠外部采购"
