    {
      "start": 254.78,
      "end": 256.04,
      "text": "没有极致的控制"
    },
    {
      "start": 256.04,
      "end": 256.94,
      "text": "就是死路一条"
    },
    {
      "start": 256.94,
      "end": 258.68,
      "text": "为什么周转率这么重要"
    },
    {
      "start": 258.68,
      "end": 259.52,
      "text": "我们来算一笔账"
    },
    {
      "start": 259.52,
      "end": 260.7,
      "text": "假设你进了一批货"
