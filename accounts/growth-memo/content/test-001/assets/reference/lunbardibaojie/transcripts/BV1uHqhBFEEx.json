    {
      "start": 446.78,
      "end": 448.16,
      "text": "在背后默默地"
    },
    {
      "start": 448.16,
      "end": 449.64,
      "text": "给这场全民逃赌"
    },
    {
      "start": 449.64,
      "end": 451.42,
      "text": "发筹码开绿灯"
