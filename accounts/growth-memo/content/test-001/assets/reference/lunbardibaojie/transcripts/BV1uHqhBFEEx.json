    {
      "start": 440.9,
      "end": 442.98,
      "text": "想要全民都坐上赌桌"
    },
    {
      "start": 442.98,
      "end": 445.12,
      "text": "光有心态就够了吗"
    },
    {
      "start": 445.12,
      "end": 446.78,
      "text": "是不是还有什么东西"
