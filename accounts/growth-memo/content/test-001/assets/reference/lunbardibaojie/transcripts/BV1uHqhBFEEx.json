    {
      "start": 498.6,
      "end": 500.3,
      "text": "信息极度不透明的市场"
    },
    {
      "start": 500.3,
      "end": 502.82,
      "text": "国际投资者称之为韩国折价"
    },
    {
      "start": 502.82,
      "end": 505.2,
      "text": "意思是韩国企业的股票价格"
    },
    {
      "start": 505.2,
      "end": 508.34,
      "text": "或部分韩国品牌的产品价值相对较低"
    },
    {
      "start": 508.34,
      "end": 510.28,
      "text": "在这里研究公司基本面"
    },
    {
      "start": 510.28,
      "end": 512.36,
      "text": "也不如揣摩财阀家族动向"
    },
    {
      "start": 512.36,
      "end": 514.02,
      "text": "或政策风向来得有效"
    },
    {
      "start": 514.02,
      "end": 515.88,
      "text": "当市场本身不具备"
    },
    {
      "start": 515.88,
      "end": 518.54,
      "text": "长期价值成长的公平性时"
    },
    {
      "start": 518.54,
      "end": 520.48,
      "text": "短期投机波段操作"
    },
    {
      "start": 520.48,
      "end": 523.74,
      "text": "就成了散户唯一理性的生存策略"
    },
    {
      "start": 523.74,
      "end": 525.58,
      "text": "聊了这么多直接原因"
    },
    {
      "start": 525.58,
      "end": 527.12,
      "text": "如果我们追根溯源"
    },
    {
      "start": 527.12,
      "end": 530.28,
      "text": "会发现一个笼罩在所有现象之上的"
    },
    {
      "start": 530.28,
      "end": 531.22,
      "text": "根本起源"
    },
    {
      "start": 531.22,
      "end": 533.86,
      "text": "一切始于那场被称作"
    },
    {
      "start": 533.86,
      "end": 535.92,
      "text": "汉江奇迹的经济狂奔"
    },
    {
      "start": 535.92,
      "end": 537.22,
      "text": "在普正熙"
    },
    {
      "start": 537.22,
      "end": 539.7,
      "text": "也就是普景惠的父亲执政时代"
    },
    {
      "start": 539.7,
      "end": 541.4,
      "text": "韩国举全国之力"
    },
    {
      "start": 541.4,
      "end": 543.58,
      "text": "将资源像赌注一样"
    },
    {
      "start": 543.58,
      "end": 545.58,
      "text": "压在少数几个产业上"
    },
    {
      "start": 545.58,
      "end": 548.62,
      "text": "催生出了三星现代这些财阀巨头"
    },
    {
      "start": 548.62,
      "end": 551.56,
      "text": "这本质上是一场国家级的豪赌"
    },
    {
      "start": 551.56,
      "end": 552.78,
      "text": "并且赌赢了"
    },
    {
      "start": 552.78,
      "end": 554.86,
      "text": "创造了从废墟跃升为"
    },
    {
      "start": 554.86,
      "end": 557.9,
      "text": "发达国家的压缩式增长神话"
    },
    {
      "start": 557.9,
      "end": 559.62,
      "text": "但奇迹的背面"
    },
    {
      "start": 559.62,
      "end": 561.56,
      "text": "是沉重的后遗症"
    },
    {
      "start": 561.56,
      "end": 562.94,
      "text": "财阀的经济垄断"
    },
    {
      "start": 562.94,
      "end": 565.04,
      "text": "让整个社会逐渐固化"
    },
    {
      "start": 565.04,
      "end": 567.8,
      "text": "也使韩国陷入了一种表面繁荣"
    },
    {
      "start": 567.8,
      "end": 570.12,
      "text": "个体绝望的撕裂状态"
    },
    {
      "start": 570.12,
      "end": 572.24,
      "text": "而历史的经验和现实的困境"
    },
    {
      "start": 572.24,
      "end": 574.94,
      "text": "共同扭去了整个社会的财富观"
    },
    {
      "start": 574.94,
      "end": 577.18,
      "text": "在那段高速增长期"
    },
    {
      "start": 577.18,
      "end": 580.0,
      "text": "不少中产并非依靠勤劳"
    },
    {
      "start": 580.0,
      "end": 582.9,
      "text": "而是借助房地产与资产投机"
    },
    {
      "start": 582.9,
      "end": 584.48,
      "text": "实现阶级跃迁"
    },
    {
      "start": 584.48,
      "end": 587.14,
      "text": "这塑造了一种深刻的全民记忆"
    },
    {
      "start": 587.14,
      "end": 588.5,
      "text": "踏实工作太慢"
    },
    {
      "start": 588.5,
      "end": 590.2,
      "text": "抓住风口才能翻身"
    },
    {
      "start": 590.2,
      "end": 591.92,
      "text": "当房地产泡沫破裂"
    },
    {
      "start": 591.92,
      "end": 594.16,
      "text": "这种对投机报复的路径依赖"
    },
    {
      "start": 594.16,
      "end": 596.6,
      "text": "便自然转移到了股市与币圈"
    },
    {
      "start": 596.6,
      "end": 598.0,
      "text": "韩国人这种"
    },
    {
      "start": 598.0,
      "end": 599.08,
      "text": "你只活一次"
    },
    {
      "start": 599.08,
      "end": 600.44,
      "text": "合不狂赌的心态"
    },
    {
      "start": 600.44,
      "end": 602.04,
      "text": "远非简单的贪婪"
    },
    {
      "start": 602.04,
      "end": 606.28,
      "text": "而是一套系统在历史制度与文化层面"
    },
    {
      "start": 606.28,
      "end": 607.76,
      "text": "合谋的结果"
    },
    {
      "start": 607.76,
      "end": 610.2,
      "text": "它始于一场国家级的豪赌"
    },
    {
      "start": 610.2,
      "end": 613.2,
      "text": "最终蔓延为全民的生存策略"
    },
    {
      "start": 613.2,
      "end": 616.6,
      "text": "在一个看似繁荣却上身无望的社会里"
    },
    {
      "start": 616.6,
      "end": 618.96,
      "text": "投机成了普通人手中"
    },
    {
      "start": 618.96,
      "end": 621.84,
      "text": "唯一看似能自己掌握的杠杆"
    },
    {
      "start": 621.84,
      "end": 623.6,
      "text": "关注《伦巴迪宝姐》"
    },
    {
      "start": 623.6,
      "end": 626.4,
      "text": "带你读懂新资产背后的财富逻辑"
    }
  ]
}