    {
      "start": 397.8,
      "end": 398.68,
      "text": "大企业"
    },
    {
      "start": 398.68,
      "end": 399.38,
      "text": "银行"
    },
    {
      "start": 399.38,
      "end": 400.66,
      "text": "甚至国家货币"
    },
    {
      "start": 400.66,
      "end": 403.24,
      "text": "都可能一夜之间变得一文不值"
