    {
      "start": 270.98,
      "end": 272.96,
      "text": "不少人可能刚大学毕业"
    },
    {
      "start": 272.96,
      "end": 275.84,
      "text": "就背上了人生第一笔大额负债"
    },
    {
      "start": 275.84,
      "end": 277.14,
      "text": "那房东这边呢"
    },
    {
      "start": 277.14,
      "end": 278.54,
      "text": "一旦资金变顿裂"
    },
    {
      "start": 278.54,
      "end": 280.08,
      "text": "压金便血本无归"
    },
    {
      "start": 280.08,
      "end": 282.24,
      "text": "最后租客房财了失"
    },
    {
      "start": 282.24,
      "end": 284.9,
      "text": "除了巨大的住房成本和债务压力"
    },
    {
      "start": 284.9,
      "end": 287.36,
      "text": "更深层次的原因还是阶级固化"
    },
    {
      "start": 287.36,
      "end": 291.06,
      "text": "不过最近韩国人也开始躺平了"
    },
    {
      "start": 291.06,
      "end": 292.9,
      "text": "之前韩国人加班到凌晨"
    },
    {
      "start": 292.9,
      "end": 294.24,
      "text": "不睡觉去健身"
    },
    {
      "start": 294.24,
      "end": 296.62,
      "text": "把冰美式当水喝续命"
    },
    {
      "start": 296.62,
      "end": 298.62,
      "text": "干不动了呢就打营养针"
    },
    {
      "start": 298.62,
      "end": 301.36,
      "text": "但现在反正全也赶不了命"
