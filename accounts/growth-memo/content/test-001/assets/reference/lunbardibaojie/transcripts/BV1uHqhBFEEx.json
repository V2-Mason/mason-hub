    {
      "start": 352.1,
      "end": 356.44,
      "text": "韩元汇率在三个月内狂跌67%"
    },
    {
      "start": 356.44,
      "end": 360.72,
      "text": "普通韩国人存在银行里的韩元财富迅速缩水"
    },
    {
      "start": 360.72,
      "end": 362.04,
      "text": "结局很悲壮"
    },
    {
      "start": 362.04,
      "end": 365.46,
      "text": "举国上下开启了全民的捐金运动"
