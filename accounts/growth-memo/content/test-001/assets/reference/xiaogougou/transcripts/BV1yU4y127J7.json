    {
      "start": 255.96,
      "end": 257.44,
      "text": "创意那可是玄学"
    },
    {
      "start": 257.44,
      "end": 259.5,
      "text": "哪有实打实的数据指标靠谱"
    },
    {
      "start": 259.5,
      "end": 260.8,
      "text": "你说拍个广告"
    },
    {
      "start": 260.8,
      "end": 261.86,
      "text": "那干嘛呀"
    },
    {
      "start": 261.86,
      "end": 262.98,
      "text": "那投入大效果"
    },
    {
      "start": 262.98,
      "end": 263.88,
      "text": "还不离干见影"
    },
    {
      "start": 263.88,
      "end": 265.52,
      "text": "现在啥都要节奏快"
    },
    {
      "start": 265.52,
      "end": 266.96,
      "text": "我品牌传播也得快"
    },
    {
      "start": 266.96,
      "end": 268.7,
      "text": "我不仅要离干见影的曝光"
