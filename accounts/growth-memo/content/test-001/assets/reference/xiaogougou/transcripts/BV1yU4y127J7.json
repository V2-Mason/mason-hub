    {
      "start": 288.64,
      "end": 289.72,
      "text": "自打这个网红"
    },
    {
      "start": 289.72,
      "end": 290.84,
      "text": "经济火起来之后"
    },
    {
      "start": 290.84,
      "end": 291.98,
      "text": "基本上这些个品牌"
    },
    {
      "start": 291.98,
      "end": 293.06,
      "text": "全都是一个路数"
    },
    {
      "start": 293.06,
      "end": 294.1,
      "text": "先是资本"
    },
    {
      "start": 294.1,
      "end": 295.86,
      "text": "资本你搞出来一个品牌"
    },
    {
      "start": 295.86,
      "end": 297.7,
      "text": "然后马上抖音小龙书"
    },
    {
      "start": 297.7,
      "end": 298.86,
      "text": "必然数据好的达人"
