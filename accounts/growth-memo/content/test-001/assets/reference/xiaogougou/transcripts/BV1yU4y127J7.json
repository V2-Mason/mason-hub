    {
      "start": 273.08,
      "end": 274.24,
      "text": "这波预算投放的"
    },
    {
      "start": 274.24,
      "end": 275.22,
      "text": "一个转化率是多少"
    },
    {
      "start": 275.22,
      "end": 276.92,
      "text": "只要能赶紧卖出钱"
    },
    {
      "start": 276.92,
      "end": 278.18,
      "text": "品牌文化重要吗"
    },
    {
      "start": 278.18,
      "end": 280.12,
      "text": "文化它又不能当饭吃"
