    {
      "start": 335.14,
      "end": 336.82,
      "text": "一开始是新锐网红品牌"
    },
    {
      "start": 336.82,
      "end": 337.72,
      "text": "特别喜欢这么搞"
    },
    {
      "start": 337.72,
      "end": 339.42,
      "text": "后来各多大牌发现这么搞"
