    {
      "start": 352.84,
      "end": 354.66,
      "text": "曾经拼创意的广告公司"
    },
    {
      "start": 354.66,
      "end": 355.58,
      "text": "甚至现在有的"
    },
    {
      "start": 355.58,
      "end": 357.2,
      "text": "连完整的品牌营销方案"
    },
    {
      "start": 357.2,
      "end": 357.9,
      "text": "都写不出来"
    },
    {
      "start": 357.9,
      "end": 359.52,
      "text": "他们都是怎么做的呢"
    },
    {
      "start": 359.52,
      "end": 361.0,
      "text": "比如我跟你这个MCN"
    },
    {
      "start": 361.0,
      "end": 361.84,
      "text": "关系特别好"
    },
    {
      "start": 361.84,
      "end": 362.92,
      "text": "这种关系好"
    },
    {
      "start": 362.92,
      "end": 364.82,
      "text": "通常是金钱层面的关系好"
    },
    {
      "start": 364.82,
      "end": 365.58,
      "text": "然后呢"
    },
    {
      "start": 365.58,
      "end": 367.24,
      "text": "我让你MCN给我出一个方案"
    },
    {
      "start": 367.24,
      "end": 368.64,
      "text": "你不用跟我讲创意"
    },
    {
      "start": 368.64,
      "end": 370.14,
      "text": "有那么个PPT就行了"
    },
    {
      "start": 370.14,
      "end": 371.4,
      "text": "反正客户下单吧"
    },
    {
      "start": 371.4,
      "end": 372.12,
      "text": "也是拼可行"
    },
    {
      "start": 372.12,
      "end": 373.38,
      "text": "谁去看你的PPT呢"
    },
    {
      "start": 373.38,
      "end": 375.02,
      "text": "反正真正执行起来"
    },
    {
      "start": 375.02,
      "end": 376.76,
      "text": "是以网红实际的脚本为准"
    },
    {
      "start": 376.76,
      "end": 378.42,
      "text": "反正项目最后执行完了"
    },
    {
      "start": 378.42,
      "end": 379.88,
      "text": "不能说跟方案一模一样吧"
