    {
      "start": 231.74,
      "end": 232.96,
      "text": "赤裸裸的数据"
    },
    {
      "start": 232.96,
      "end": 233.86,
      "text": "就给你摆在那"
    },
    {
      "start": 236.06,
      "end": 236.7,
      "text": "社交平台"
    },
    {
      "start": 236.7,
      "end": 237.74,
      "text": "品牌营销"
    },
    {
      "start": 237.74,
      "end": 239.66,
      "text": "慢慢也就局限在了社交营销"
    },
    {
      "start": 239.66,
      "end": 240.8,
      "text": "一说啥品牌"
    },
    {
      "start": 240.8,
      "end": 242.02,
      "text": "想做一个投放啊"
    },
    {
      "start": 242.02,
      "end": 243.02,
      "text": "第一反应不是说"
    },
    {
      "start": 243.02,
      "end": 244.36,
      "text": "你要拍一条什么样的广告"
    },
    {
      "start": 244.36,
      "end": 245.66,
      "text": "是我赶紧看看"
    },
    {
      "start": 245.66,
      "end": 246.92,
      "text": "哪个平台的流量好"
    },
    {
      "start": 246.92,
      "end": 248.5,
      "text": "在流量好的平台里"
    },
    {
      "start": 248.5,
      "end": 250.18,
      "text": "再找找哪个网红的数据好"
    },
    {
      "start": 250.18,
      "end": 251.62,
      "text": "我就挑数据好的"
    },
    {
      "start": 251.62,
      "end": 252.52,
      "text": "完全投一遍"
    },
    {
      "start": 252.52,
      "end": 253.76,
      "text": "那你这么个头发"
    },
    {
      "start": 253.76,
      "end": 254.84,
      "text": "猪都能起飞了"
    },
    {
      "start": 254.84,
      "end": 255.96,
      "text": "你说创意"
