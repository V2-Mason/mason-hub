    {
      "start": 223.14,
      "end": 223.82,
      "text": "户外广告"
    },
    {
      "start": 223.82,
      "end": 225.28,
      "text": "一个创意好或者不好"
    },
    {
      "start": 225.28,
      "end": 226.06,
      "text": "它是没有力"
    },
    {
      "start": 226.06,
      "end": 227.54,
      "text": "跟进的考评标准的"
    },
    {
      "start": 227.54,
      "end": 229.1,
      "text": "更多的是一个长期的"
    },
    {
      "start": 229.1,
      "end": 230.1,
