    },
    {
      "start": 174.06,
      "end": 175.22,
      "text": "它是啥意思呢"
    },
    {
      "start": 175.22,
      "end": 177.08,
      "text": "就是连麦当劳叔叔"
    },
    {
      "start": 177.08,
      "end": 178.18,
      "text": "也来买汉堡王了"
    },
    {
      "start": 178.18,
      "end": 179.3,
      "text": "再比如这个图"
    },
    {
      "start": 179.3,
      "end": 180.7,
      "text": "这个事儿起初是"
    },
    {
      "start": 180.7,
      "end": 182.3,
      "text": "汉堡王的门店着火了"
    },
    {
      "start": 182.3,
      "end": 184.06,
      "text": "但他们马上借这个事件"
    },
    {
      "start": 184.06,
      "end": 185.06,
      "text": "搞起了一个营销"
    },
    {
      "start": 185.06,
      "end": 186.22,
      "text": "说自己着火"
    },
    {
      "start": 186.22,
      "end": 187.08,
      "text": "是因为汉堡"
    },
    {
      "start": 187.08,
      "end": 188.62,
      "text": "是正人巴结运火烤的"
    },
    {
      "start": 188.62,
      "end": 190.42,
      "text": "暗指的就是他们竞争对手"
    },
    {
      "start": 190.42,
      "end": 191.78,
      "text": "麦当劳的汉堡是炸的"
    },
    {
      "start": 191.78,
      "end": 192.34,
      "text": "不正宗"
    },
    {
      "start": 192.34,
      "end": 194.26,
      "text": "麦当劳其实也反击过"
    },
    {
      "start": 194.26,
      "end": 195.32,
      "text": "比如这个啊"
    },
    {
      "start": 195.32,
      "end": 196.82,
      "text": "他就是在高速公路旁"
