      "start": 318.44,
      "end": 319.58,
      "text": "是不是挺好的呀"
    },
    {
      "start": 319.58,
      "end": 320.76,
      "text": "那我买一个试试吧"
    },
    {
      "start": 320.76,
      "end": 321.56,
      "text": "你一试"
