    {
      "start": 342.14,
      "end": 344.08,
      "text": "来快速优化这个内容"
    },
    {
      "start": 344.08,
      "end": 345.2,
      "text": "传统人工测试呢"
    },
    {
      "start": 345.2,
      "end": 346.12,
      "text": "它的效率很低"
    },
    {
      "start": 346.12,
      "end": 347.56,
      "text": "但是如今AI呢"
    },
    {
      "start": 347.56,
      "end": 350.46,
      "text": "它可以把广告拆解成文案视觉等元素"
    },
    {
      "start": 350.46,
      "end": 352.0,
      "text": "在虚拟的流量池中"
