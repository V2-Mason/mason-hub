    {
      "start": 352.0,
      "end": 353.66,
      "text": "投放这种七百种变体"
    },
    {
      "start": 353.66,
      "end": 355.34,
      "text": "来实施检测数据"
    },
    {
      "start": 355.34,
      "end": 358.0,
      "text": "并且自动筛选出这个优质的排列组合"
    },
    {
      "start": 358.0,
      "end": 360.02,
      "text": "极大的提升了这个测试的效率"
    },
    {
      "start": 360.02,
      "end": 360.72,
      "text": "总之吧"
    },
    {
      "start": 360.72,
      "end": 362.46,
      "text": "就是当前AI工具呢"
    },
    {
      "start": 362.46,
      "end": 364.36,
      "text": "在营销投放规划的角度吧"
    },
    {
      "start": 364.36,
      "end": 366.48,
      "text": "更适合去作为一种辅助手段"
