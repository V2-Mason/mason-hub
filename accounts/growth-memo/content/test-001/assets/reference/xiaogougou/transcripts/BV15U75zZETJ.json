    {
      "start": 223.23,
      "end": 224.07,
      "text": "其次吧"
    },
    {
      "start": 224.07,
      "end": 225.03,
      "text": "就是这样的方案呢"
    },
    {
      "start": 225.03,
      "end": 226.55,
      "text": "它其实只能做常规投放"
    },
    {
      "start": 226.55,
      "end": 228.61,
      "text": "我在屏幕上分别展示了"
