    {
      "start": 248.17,
      "end": 250.01,
      "text": "对于品牌调性的传递"
    },
    {
      "start": 250.01,
      "end": 251.15,
      "text": "和个性的展示呢"
    },
    {
      "start": 251.15,
      "end": 252.15,
      "text": "有更高的要求"
    },
    {
      "start": 252.15,
      "end": 253.31,
      "text": "那这种呢"
    },
    {
      "start": 253.31,
      "end": 255.21,
      "text": "它AI其实就处理不了了"
    },
    {
      "start": 255.21,
      "end": 256.29,
      "text": "第三呢"
    },
    {
      "start": 256.29,
      "end": 257.67,
      "text": "就是这个AI产品呢"
    },
    {
      "start": 257.67,
      "end": 258.47,
      "text": "它用一次"
