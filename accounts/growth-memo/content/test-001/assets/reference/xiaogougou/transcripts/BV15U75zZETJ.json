    {
      "start": 228.61,
      "end": 230.83,
      "text": "两种品牌常见的需求样本啊"
    },
    {
      "start": 230.83,
      "end": 232.07,
      "text": "左边就是常规投放"
    },
    {
      "start": 232.07,
      "end": 233.51,
      "text": "也就是AI可以处理的"
    },
    {
      "start": 233.51,
      "end": 234.45,
      "text": "那右边呢"
    },
    {
      "start": 234.45,
      "end": 235.35,
      "text": "就是事件营销"
    },
    {
      "start": 235.35,
      "end": 236.95,
      "text": "也就是所谓的这个Campaign"
    },
    {
      "start": 236.95,
      "end": 238.67,
      "text": "这两种需求的区别呢"
    },
    {
      "start": 238.67,
      "end": 239.31,
      "text": "就在于说"
    },
    {
      "start": 239.31,
      "end": 241.59,
      "text": "常规投放它是稳定的引流"
    },
    {
      "start": 241.59,
      "end": 243.25,
      "text": "通过日常的细水长流"
    },
    {
      "start": 243.25,
      "end": 244.85,
      "text": "来完成内容的输出"
    },
    {
      "start": 244.85,
      "end": 246.59,
      "text": "而事件营销这块呢"
    },
    {
      "start": 246.59,
      "end": 248.17,
      "text": "它更看重创业跟玩法"
