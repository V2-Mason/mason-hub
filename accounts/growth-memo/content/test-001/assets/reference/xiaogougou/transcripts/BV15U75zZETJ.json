    {
      "start": 100.24,
      "end": 104.54,
      "text": "那先简单科普一下吧"
    },
    {
      "start": 104.54,
      "end": 106.6,
      "text": "在整个达人营销这个链路中"
    },
    {
      "start": 106.6,
      "end": 109.1,
      "text": "咱们可以简单分为这么几种角色啊"
    },
    {
      "start": 109.1,
      "end": 109.96,
      "text": "品牌广告主"
    },
    {
      "start": 109.96,
      "end": 111.78,
      "text": "或者说他们的广告代理公司"
    },
    {
      "start": 111.78,
      "end": 112.7,
      "text": "M3机构"
    },
    {
      "start": 112.7,
      "end": 113.96,
      "text": "内容创作者"
    },
    {
      "start": 113.96,
      "end": 116.0,
      "text": "也就是各位up主们达人"
    },
    {
      "start": 116.0,
      "end": 117.28,
      "text": "最终消费者"
    },
    {
      "start": 117.28,
      "end": 118.74,
      "text": "或者说准确的讲"
    },
    {
      "start": 118.74,
      "end": 120.32,
      "text": "就是最终内容消费者"
    },
    {
      "start": 120.32,
      "end": 122.34,
      "text": "但是这个他其实是一个"
