    {
      "start": 332.16,
      "end": 334.0,
      "text": "就是精准拦截需求"
    },
    {
      "start": 334.0,
      "end": 335.48,
      "text": "由于不同人群呢"
    },
    {
      "start": 335.48,
      "end": 336.54,
      "text": "它的出发点不同"
    },
    {
      "start": 336.54,
      "end": 338.42,
      "text": "而且用户它其实容易对"
