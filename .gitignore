
# Python cache
__pycache__/
*.pyc

# Virtual environment
.venv/

# ChromaDB (large, auto-generated from lessons.md)
memory/chroma_db/

# API usage logs (large, auto-generated)
logs/api_usage.jsonl
logs/cron.log

# Log archive (large, auto-generated)
logs/archive/

# Large binary files (exceed GitHub 100MB limit)
*.xlsx

# Credentials (never commit)
.credentials/
.env
tools/trendradar/
logs/trendradar.log
tools/trendradar-config/reports/

# SQLite databases (runtime data, not code)
*.db

# Git worktrees (agent 分支工作目录)
.worktrees/
credentials/

# 素材/资产（二进制大文件不入 git）
**/assets/**/*.png
**/assets/**/*.jpg
**/assets/**/*.jpeg
**/assets/**/*.mp4
**/assets/**/*.mov
**/assets/**/*.wav
**/assets/**/*.mp3
**/assets/**/*.webm
**/assets/**/*.gif
**/assets/**/*.pak

# assets 下的 node_modules 和构建产物
**/assets/**/node_modules/
**/assets/**/.next/
**/assets/**/dist/
**/assets/**/build/

# package-lock（可重建）
**/package-lock.json

# 保留 assets 下的 md/yaml/json 配置文件（不在此忽略）
autoresearch-results.tsv

# IDE 配置
.vscode/
.claude/settings.local.json

# 视频/音频/图片产出（output 目录）
**/output/**/*.mp4
**/output/**/*.mp3
**/output/**/*.png
**/output/**/*.jpg

# Envato/素材参考帧
**/source/original-frames/
**/source/**/*.jpg
**/source/**/*.png

# 内容产出大文件（不在 assets 下的）
**/content/**/*.mp4
**/content/**/*.mp3
**/content/**/*.wav
**/content/**/*.jpg
**/content/**/*.png
**/content/**/*.jpeg
**/content/**/temp/
